# Hermes Easy — example environment file
# Copy the lines you need into the service's .env in Easypanel.
# Every variable here is optional unless noted.

# --- Model / endpoint ---
# Default model at startup (e.g. autoversio, gpt-4o, anthropic/claude-opus-4.6).
# Must be non-empty, otherwise Hermes falls back to its stored config default.
HERMES_MODEL=

# OpenAI-compatible endpoint (vLLM, Ollama, custom). API key must be set even
# if the endpoint doesn't validate it.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Provider API keys (switch provider live via /model in the dashboard) ---
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# --- Dashboard auth ---
# Default (INSECURE=1): no login required. Good for dev or a trusted LAN.
# To add a password: set INSECURE to empty AND fill in the BASIC_AUTH vars.
# WARNING: setting INSECURE= (empty) without BASIC_AUTH configured crashes the container.
HERMES_DASHBOARD_INSECURE=1

# Username/password login — set all three to enable.
# INSECURE must be unset (empty string) for these to take effect.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# A long random string. Required for sessions to survive container restarts.
# Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- Networking ---
# Host port the dashboard is published on. Give each instance a unique port
# if you keep host-port publishing (domain access via Traefik ignores this).
APP_PORT=9119
# Host interface to bind. 0.0.0.0 to reach it from outside the server.
APP_BIND=127.0.0.1

# --- Runtime user (rarely changed) ---
HERMES_UID=10000
HERMES_GID=10000
