# hermes-easy — paste into the service's Environment panel in Easypanel and fill in.
# Every variable is optional except the three dashboard ones. env.md explains each.

# --- Model: provider/model. The prefix is a HERMES_PROVIDERS id or a catalogue slug ---
# (catalogue: openai-api, anthropic, gemini, deepseek, xai, nous, ollama-cloud, router --
# plain `openai` does not exist). Never leave the provider to be guessed from the name:
# glm-5.3-flash on your own box resolves to Z.ai and the agent asks for a Z.ai key.
HERMES_MODEL=house/glm-5.3-flash
# An endpoint you host, as a provider of its own: id|Display name|base_url|KEY_VARIABLE.
# Name it for its role (house, private, lab), not its hardware. Several: separate with ';'.
HERMES_PROVIDERS=house|House endpoint|https://your-endpoint/v1|PRIVATE_LLM_API_KEY
PRIVATE_LLM_API_KEY=

# --- Hosted providers: fill in the ones you want to switch to with /model ---
# (also OPENROUTER_, GEMINI_, DEEPSEEK_, GROQ_, XAI_, MISTRAL_API_KEY)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Dashboard: all three required, or the Domain answers 502 ---
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- SkillHub (shared data store) ---
# An agent: SUPABASE_MCP_KEY=one MCP_KEY_NN, HERMES_AGENT_ID=agent_NN, SUPABASE_ADMIN_KEY empty.
# The caretaker: the service key in BOTH key fields, HERMES_AGENT_ID=service_role.
SUPABASE_MCP_URL=https://your-store
SUPABASE_MCP_KEY=
SUPABASE_ADMIN_KEY=
HERMES_AGENT_ID=

# --- Rarely changed ---
# Image tag to pin, e.g. v2026.9.7. Empty = latest.
#HERMES_TAG=
HERMES_UID=10000
HERMES_GID=10000
