# Hermes Easy — example environment file
# Copy the lines you need into the service's Environment panel in Easypanel.
# Every variable here is optional unless noted.

# --- Model / provider ---
# These are WRITTEN INTO config.yaml BY THE BOOT SEED on every boot. That indirection is
# not decoration: Hermes reads the active model from config.yaml and only from there
# (tui_gateway/server.py:1423, hermes_cli/config.py:2989), and the image ships
# model.default=anthropic/claude-opus-4.6 with base_url=https://openrouter.ai/api/v1.
# Before the seed existed, two agents whose panels read openai/gpt-5.6-luna had both been
# running Claude through OpenRouter for a day. Only the agent without an
# OPENROUTER_API_KEY noticed, and it reported "payment / credit error", not the real cause.
#
# BARE model name. A provider/model prefix is sent to the endpoint verbatim and comes back
# as HTTP 404 ("the model `openai/gpt-5.6-luna` does not exist"), or is looked up as a
# provider and fails with "Unknown provider". The seed warns in the log if it sees a "/".
HERMES_MODEL=gpt-5.6-luna
# Slug from Hermes' own provider catalogue — 79 of them, and the names are not what you
# would guess: the OpenAI API is `openai-api`, plain `openai` DOES NOT EXIST, and
# `openai-codex` is the ChatGPT-subscription route instead. Others in use:
# anthropic, gemini, deepseek, xai, nous, ollama-cloud, router. For an endpoint of your
# own, see "Private AI" below. Verify a slug with `hermes model` in a real terminal.
HERMES_PROVIDER=openai-api
# Leave empty. A catalogue provider brings its own endpoint, and the seed REMOVES
# model.base_url when this is empty — otherwise the image's openrouter.ai default lingers
# and contradicts the provider (auxiliary_client.py:4136 warns about exactly that state).
HERMES_MODEL_BASE_URL=

# Read by the OpenAI SDK itself, not by the model seed above. OPENAI_API_KEY is what
# HERMES_PROVIDER=openai-api authenticates with, so it is required for that provider.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Provider API keys (switch provider live via /model in the dashboard) ---
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# --- Private AI / your own endpoint (placeholder — not seeded from env yet) ---
# A private or on-premise endpoint is not a catalogue provider, so it needs a NAMED entry
# and `model.provider = custom:<name>`. Do not use a bare "custom": the entry name is then
# lost and the api_key has to sit in clear text in config.yaml
# (runtime_provider_custom.py:220). With `key_env` the key stays in this panel and never
# reaches the data volume — the same rule as SUPABASE_MCP_KEY.
#
# Until there is a real endpoint to test the seeding against, set it up once per agent:
#
#   docker exec -u 10000:10000 -e HOME=/opt/data <container> \
#     hermes config set providers.house.base_url https://your-endpoint/v1
#   ... providers.house.key_env       PRIVATE_LLM_API_KEY
#   ... providers.house.default_model your-model
#   ... providers.house.api_mode      chat_completions
#   ... model.provider               custom:house
#   ... model.default                your-model
#
# which produces this in config.yaml:
#
#   providers:
#     house:
#       base_url: https://your-endpoint/v1
#       key_env: PRIVATE_LLM_API_KEY     # the NAME of the variable, not the key
#       default_model: your-model
#       api_mode: chat_completions
#
# The entry lives on the volume and survives a Redeploy, but a NEW agent starts on the
# image default again — so put the key below and set the entry when you create the agent.
# The aliases ollama, vllm and llamacpp also resolve to custom.
PRIVATE_LLM_API_KEY=

# --- Dashboard auth (REQUIRED) ---
# Hermes >= 2026.9 refuses to bind the dashboard on 0.0.0.0 without an auth
# provider, and HERMES_DASHBOARD_INSECURE no longer disables the gate there.
# Set all three. The container fails closed without them.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# A long random string; sessions die on every restart without it. openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Only meaningful for images older than 2026.9. Leave empty.
HERMES_DASHBOARD_INSECURE=

# --- Shared Supabase via MCP ---
# Streamable-HTTP MCP endpoint behind Kong key-auth (see supabase-easy). Both must be set
# for the boot seed to write mcp_servers.supabase into config.yaml.
SUPABASE_MCP_URL=
# One MCP_KEY_NN from the Supabase service's environment (openssl rand -hex 32 there).
SUPABASE_MCP_KEY=
# This agent's identifier in the shared data: agent_NN with the same NN as the key slot.
HERMES_AGENT_ID=
# The house's own MCP tools (supabase-easy edge function `skillhub`), same key. Empty is
# derived from SUPABASE_MCP_URL (.../mcp -> .../skillhub); set to "-" to disable.
SUPABASE_SKILLHUB_URL=

# --- Image updates ---
# always (default): fetch the image on every Redeploy. missing: reuse the cached one.
PULL_POLICY=always
# Docker Hub tag. Empty = latest (tracks upstream main, usually ahead of the newest
# release). Pin e.g. v2026.9.7 for reproducible redeploys.
HERMES_TAG=

# --- Networking ---
# There is no host port. The dashboard is reached through the service's Domain in
# Easypanel (Traefik -> container port 9119). APP_PORT / APP_BIND from older versions of
# this file are gone; a `ports:` binding breaks the second instance on the same host.

# --- Persistence ---
# All state is in the named volume `data` mounted at /opt/data: config.yaml, SOUL.md,
# sessions, memories, skills, cron, and the packages the agent installs itself. Nothing
# to configure; a Redeploy keeps it. Durable *system* packages (apt) do NOT survive a
# redeploy — those belong in a Dockerfile, see README.
# Playwright browsers ship inside the image; leave this empty.
PLAYWRIGHT_BROWSERS_PATH=
# Where the agent's own `npm install -g` / `uv tool install` land. Defaults put them on
# the volume and on PATH; leave empty unless you want somewhere else.
NPM_CONFIG_PREFIX=
UV_TOOL_DIR=
UV_TOOL_BIN_DIR=

# --- Runtime user (rarely changed) ---
HERMES_UID=10000
HERMES_GID=10000
